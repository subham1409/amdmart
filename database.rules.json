{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "college": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userPrivate": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^\\\\+?[0-9]{10,15}$/)"
        },
        "$other": {
          ".validate": false
        },
        "location": {
          ".validate": "newData.hasChildren(['area','lat','lng']) && newData.child('area').isString() && newData.child('area').val().length <= 100 && newData.child('lat').isNumber() && newData.child('lng').isNumber()",
          "area": {
            ".validate": "newData.isString()"
          },
          "lat": {
            ".validate": "newData.isNumber()"
          },
          "lng": {
            ".validate": "newData.isNumber()"
          },
          "src": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "categories": {
      ".read": true,
      "$cid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "order": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "products": {
      ".read": true,
      ".indexOn": [
        "category",
        "sellerId",
        "createdAt",
        "status"
      ],
      "$pid": {
        ".write": "auth != null && ((!data.exists() && newData.child('sellerId').val() === auth.uid) || (data.exists() && (data.child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())))",
        ".validate": "newData.hasChildren(['title','price','category','sellerId','status','createdAt','verified'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "originalPrice": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "category": {
          ".validate": "newData.isString() && root.child('categories').child(newData.val()).exists()"
        },
        "condition": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "sellerId": {
          ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === auth.uid"
        },
        "verified": {
          ".validate": "newData.isBoolean() && (root.child('admins').child(auth.uid).exists() || newData.val() === (data.exists() ? data.val() : false))"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(active|sold)$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "thumb": {
          ".validate": "newData.isString() && newData.val().length < 100000"
        },
        "imageCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "imageUrls": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length < 1000"
          }
        },
        "area": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "productImages": {
      "$pid": {
        ".read": true,
        "$i": {
          ".validate": "newData.isString() && newData.val().matches(/^data:image\\/jpeg;base64,/) && newData.val().length < 400000"
        },
        ".write": "auth != null && (root.child('products').child($pid).child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "favourites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$pid": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$rid": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('buyerId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('admins').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['productId','buyerId','sellerId','status','createdAt']) && newData.child('buyerId').val() !== newData.child('sellerId').val() && (!newData.child('couponCode').exists() || newData.hasChildren(['couponType','couponValue','couponDiscount','listedPrice','finalPrice']))",
        "productId": {
          ".validate": "newData.isString() && root.child('products').child(newData.val()).exists()"
        },
        "productTitle": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "buyerId": {
          ".validate": "newData.val() === auth.uid"
        },
        "buyerName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "sellerId": {
          ".validate": "newData.val() === root.child('products').child(newData.parent().child('productId').val()).child('sellerId').val()"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "status": {
          ".write": "auth != null && data.parent().child('buyerId').val() === auth.uid && newData.val() === 'cancelled'",
          ".validate": "newData.isString() && newData.val().matches(/^(pending|cancelled)$/) && (data.exists() || newData.val() === 'pending')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "adminStatus": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|rejected)$/) && (root.child('admins').child(auth.uid).exists() || newData.val() === 'pending')"
        },
        "adminUpdatedAt": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "couponCode": {
          ".validate": "newData.isString() && root.child('coupons').child(newData.val()).exists() && !root.child('couponUses').child(newData.val()).child(auth.uid).exists() && newData.parent().parent().parent().child('couponUses').child(newData.val()).child(auth.uid).exists()"
        },
        "couponType": {
          ".validate": "newData.isString() && newData.val() === root.child('coupons').child(newData.parent().child('couponCode').val()).child('type').val()"
        },
        "couponValue": {
          ".validate": "newData.isNumber() && newData.val() === root.child('coupons').child(newData.parent().child('couponCode').val()).child('value').val()"
        },
        "listedPrice": {
          ".validate": "newData.isNumber() && newData.val() === root.child('products').child(newData.parent().child('productId').val()).child('price').val()"
        },
        "couponDiscount": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= newData.parent().child('listedPrice').val() && (newData.parent().child('couponType').val() === 'flat' ? newData.val() <= newData.parent().child('couponValue').val() : newData.val() <= newData.parent().child('listedPrice').val() * newData.parent().child('couponValue').val() / 100 + 1)"
        },
        "finalPrice": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() === newData.parent().child('listedPrice').val() - newData.parent().child('couponDiscount').val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$rid": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && root.child('requests').child($rid).child('buyerId').val() === auth.uid && ($uid === root.child('requests').child($rid).child('buyerId').val() || $uid === root.child('requests').child($rid).child('sellerId').val())))",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$nid": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('fromUid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['type','title','message','read','createdAt','fromUid'])",
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "requestId": {
            ".validate": "newData.isString()"
          },
          "fromUid": {
            ".validate": "newData.isString()"
          },
          "read": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "coupons": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['code','type','value','maxUses','used','active','createdAt'])",
        "code": {
          ".validate": "newData.isString() && newData.val() === $code && newData.val().matches(/^[A-Z0-9_-]{3,20}$/)"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(pct|flat)$/)"
        },
        "value": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000 && (newData.parent().child('type').val() !== 'pct' || newData.val() <= 100)"
        },
        "maxUses": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
        },
        "used": {
          ".write": "auth != null && newData.exists() && data.parent().child('active').val() === true && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.val() <= data.parent().child('maxUses').val() && !root.child('couponUses').child($code).child(auth.uid).exists() && newData.parent().parent().parent().child('couponUses').child($code).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('maxUses').val()"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "couponUses": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$code": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}