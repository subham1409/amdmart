# Copy to .env  (cp .env.example .env)
PORT=3000
# Path to your service-account JSON (Firebase Console > Project settings > Service accounts > Generate key).
# Keep it OUT of git and NEVER put it in frontend code.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://amdmart-cb4d9-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=amdmart-cb4d9.firebasestorage.app
